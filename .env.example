# Vite browser-safe API URL. Supabase secrets belong only in backend/.env.
VITE_API_URL=http://127.0.0.1:8000
# Optional XYZ raster tile URL. Defaults to the standard OSM tile service for development.
# For production, point at infrastructure whose usage policy supports your traffic.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
