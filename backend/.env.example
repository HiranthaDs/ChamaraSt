# Copy this file to backend/.env and fill in the values.
APP_ENV=development

# Supabase Dashboard > Project Settings > Database > Connection string > Transaction pooler
# Port 6543 is the transaction pooler. URL-encode special characters in the password
# (for example, @ becomes %40). Keep the database password server-side only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Comma-separated URLs where the React frontend runs.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

API_HOST=127.0.0.1
API_PORT=8000

